<Application x:Class="ShortcutLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#1e1f26"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2a2c38"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7c8cff"/>
        <SolidColorBrush x:Key="TextBrush" Color="#f2f2f5"/>
    </Application.Resources>
</Application>
