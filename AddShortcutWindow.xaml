<Window x:Class="ShortcutLauncher.AddShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atalho" Height="520" Width="380"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Nome" Foreground="White" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

        <TextBlock Text="Tipo" Foreground="White" Margin="0,0,0,4"/>
        <ComboBox x:Name="TypeBox" Margin="0,0,0,10" SelectionChanged="TypeBox_SelectionChanged">
            <ComboBoxItem Content="Application" Tag="Application"/>
            <ComboBoxItem Content="Folder" Tag="Folder"/>
            <ComboBoxItem Content="Url" Tag="Url"/>
            <ComboBoxItem Content="Command" Tag="Command"/>
        </ComboBox>

        <TextBlock Text="Caminho / URL / comando" Foreground="White" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button Content="..." DockPanel.Dock="Right" Width="30" Click="BrowseClick"/>
            <TextBox x:Name="PathBox"/>
        </DockPanel>

        <TextBlock Text="Argumentos (opcional)" Foreground="White" Margin="0,0,0,4"/>
        <TextBox x:Name="ArgsBox" Margin="0,0,0,10"/>

        <TextBlock Text="Atalho global (opcional)" Foreground="White" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,10">
            <Button Content="Limpar" DockPanel.Dock="Right" Width="60" Click="ClearHotkeyClick"/>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" Text="Nenhum" Focusable="True"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
        </DockPanel>

        <StackPanel x:Name="DiscordPanel" Margin="0,0,0,16">
            <CheckBox x:Name="DiscordTrackBox" Content="Mostrar no Discord Rich Presence"
                      Foreground="White" Margin="0,0,0,8" Checked="DiscordTrackBox_CheckedChanged"
                      Unchecked="DiscordTrackBox_CheckedChanged"/>
            <TextBlock Text="Servidor ativo (opcional)" Foreground="White" Margin="0,0,0,4"/>
            <TextBox x:Name="DiscordServerBox"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="CancelClick"/>
            <Button Content="Salvar" Width="90" Click="SaveClick"/>
        </StackPanel>
    </StackPanel>
</Window>
