<Window x:Class="ShortcutLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut Launcher"
        Height="420" Width="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,10">
            <TextBlock Text="Meus atalhos" Foreground="{StaticResource TextBrush}"
                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="  (Ctrl+Alt+L para abrir/fechar)" Foreground="Gray"
                       FontSize="11" VerticalAlignment="Center" Margin="8,4,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="ShortcutsPanel" Orientation="Horizontal"/>
        </ScrollViewer>
    </DockPanel>
</Window>
