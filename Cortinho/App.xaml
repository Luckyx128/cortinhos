<Application x:Class="Cortinho.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cortinho"
             StartupUri="NotchWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.Shared.xaml"/>
                <!-- Índice 1 — cor. ThemeService troca essa entrada em runtime (dark é o placeholder de
                     build-time; App.xaml.cs chama ThemeService.ApplySaved() antes do StartupUri criar a NotchWindow). -->
                <ResourceDictionary Source="Theme/Tokens.Dark.xaml"/>
                <ResourceDictionary Source="Theme/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
