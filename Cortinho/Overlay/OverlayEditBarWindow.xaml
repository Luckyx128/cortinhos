<Window x:Class="Cortinho.Overlay.OverlayEditBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Edit Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">
    <!-- Barra do modo de edição (PHASE-OVERLAY.md §9). Margem de 20 em volta pra sombra elev-4
         não ser recortada pelo limite da janela. -->
    <Border Margin="20" Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="18,10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Arraste as ilhas — elas encaixam nas bordas."
                       FontFamily="{DynamicResource FontBody}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <Button x:Name="RestoreButton" Content="Restaurar arranjo" Style="{StaticResource GhostButtonStyle}"
                    Margin="18,0,0,0" Click="RestoreButton_Click"/>
            <Button x:Name="SaveButton" Content="Salvar" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,0,0,0" Click="SaveButton_Click"/>
        </StackPanel>
    </Border>
</Window>
