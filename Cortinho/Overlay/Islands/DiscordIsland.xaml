<UserControl x:Class="Cortinho.Overlay.Islands.DiscordIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <StackPanel>
        <Grid Margin="0,0,0,10">
            <TextBlock Text="DISCORD" FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
            <Border x:Name="ToggleTrack" Width="34" Height="20" CornerRadius="10" HorizontalAlignment="Right"
                    Background="{DynamicResource Surface3Brush}" Cursor="Hand" MouseLeftButtonDown="Toggle_Click">
                <Border x:Name="ToggleKnob" Width="16" Height="16" CornerRadius="8" Background="White"
                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
            </Border>
        </Grid>

        <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                        <GradientStop Color="#1F4A73" Offset="0"/>
                        <GradientStop Color="#132B45" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="GamepadBody" Opacity="0.5"
                              Data="M10.667 6.134l-.502-.355A4.24 4.24 0 0 0 7.715 5h-.612c-.405 0-.813.025-1.194.16c-2.383.846-4.022 3.935-3.903 10.943c.024 1.412.354 2.972 1.628 3.581A3.2 3.2 0 0 0 5.027 20a2.74 2.74 0 0 0 1.53-.437c.41-.268.77-.616 1.13-.964c.444-.43.888-.86 1.424-1.138a4.1 4.1 0 0 1 1.89-.461H13c.658 0 1.306.158 1.89.46c.536.279.98.709 1.425 1.139c.36.348.72.696 1.128.964c.39.256.895.437 1.531.437a3.2 3.2 0 0 0 1.393-.316c1.274-.609 1.604-2.17 1.628-3.581c.119-7.008-1.52-10.097-3.903-10.942C17.71 5.025 17.3 5 16.897 5h-.612a4.24 4.24 0 0 0-2.45.78l-.502.354a2.31 2.31 0 0 1-2.666 0"
                              Fill="{DynamicResource TextTertiaryBrush}"/>
                        <Path x:Name="GamepadDetail"
                              Data="M16.75 9a.75.75 0 1 1 0 1.5a.75.75 0 0 1 0-1.5m-9.25.25a.75.75 0 0 1 .75.75v.75H9a.75.75 0 0 1 0 1.5h-.75V13a.75.75 0 0 1-1.5 0v-.75H6a.75.75 0 0 1 0-1.5h.75V10a.75.75 0 0 1 .75-.75m11.5 2a.75.75 0 1 1-1.5 0a.75.75 0 0 1 1.5 0m-3.75.75a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m2.25.75a.75.75 0 1 0-1.5 0a.75.75 0 0 0 1.5 0"
                              Fill="{DynamicResource TextTertiaryBrush}"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AppNameText" Text="Rastreio desativado" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Border x:Name="StatusDot" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimeText" Text="--:--" FontFamily="{DynamicResource FontMono}" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
