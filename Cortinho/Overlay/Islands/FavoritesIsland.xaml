<UserControl x:Class="Cortinho.Overlay.Islands.FavoritesIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <StackPanel>
        <TextBlock Text="FAVORITOS" FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>

        <ItemsControl x:Name="ItemsHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="42" Height="42" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,6,6"
                            Cursor="Hand" ToolTip="{Binding Name}"
                            MouseLeftButtonDown="FavoriteButton_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Viewbox Width="19" Height="19">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding IconLayer1}" Opacity="{Binding IconLayer1Opacity}" Fill="{DynamicResource AccentBrush}"/>
                                <Path Data="{Binding IconLayer2}" Opacity="{Binding IconLayer2Opacity}" Fill="{DynamicResource AccentBrush}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="EmptyLabel" Text="Sem favoritos." FontFamily="{DynamicResource FontBody}" FontSize="12"
                   Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
