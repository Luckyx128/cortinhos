<UserControl x:Class="Cortinho.Overlay.Islands.PerfIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <StackPanel x:Name="Root">
        <TextBlock Text="DESEMPENHO" FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal">
            <Border Width="109" Margin="0,0,6,0" Padding="9,7" CornerRadius="{DynamicResource RadiusSm}"
                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CPU" FontFamily="{DynamicResource FontMono}" FontSize="9.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="CpuValueText" Text="—" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                    <Grid Height="2" Background="{DynamicResource Surface3Brush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="CpuBarFillCol" Width="0*"/>
                            <ColumnDefinition x:Name="CpuBarEmptyCol" Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CpuBarFill" Grid.Column="0" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Width="109" Padding="9,7" CornerRadius="{DynamicResource RadiusSm}"
                    Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GPU" FontFamily="{DynamicResource FontMono}" FontSize="9.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock x:Name="GpuValueText" Text="—" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                    <Grid Height="2" Background="{DynamicResource Surface3Brush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="GpuBarFillCol" Width="0*"/>
                            <ColumnDefinition x:Name="GpuBarEmptyCol" Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="GpuBarFill" Grid.Column="0" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
