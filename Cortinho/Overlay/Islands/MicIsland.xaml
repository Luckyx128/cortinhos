<UserControl x:Class="Cortinho.Overlay.Islands.MicIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="232">
    <StackPanel>
        <TextBlock Text="MIC + ÁUDIO" FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10"/>

        <!-- Grid, não StackPanel: os rótulos são fixos ("Mic"/"Áudio", o estado mutado só troca cor e
             glifo, conforme §5.3), mas a coluna * do medidor garante que nada transborde os 264 DIPs
             mesmo se o conteúdo crescer — o StackPanel anterior empurrava o medidor pra fora da ilha. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Botão Mic -->
            <Border x:Name="MicButton" Grid.Column="0" Height="34" CornerRadius="4" Padding="11,0" Cursor="Hand"
                    MouseLeftButtonDown="MicButton_Click" Margin="0,0,7,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="24" Height="24">
                            <Canvas x:Name="MicOnIcon" Width="24" Height="24">
                                <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                            <Canvas x:Name="MicOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                                      Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="MicLabel" Text="Mic" FontFamily="{DynamicResource FontBody}" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Botão Áudio -->
            <Border x:Name="AudioButton" Grid.Column="1" Height="34" CornerRadius="4" Padding="11,0" Cursor="Hand"
                    MouseLeftButtonDown="AudioButton_Click" Margin="0,0,7,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Grid Width="24" Height="24">
                            <Canvas x:Name="AudioOnIcon" Width="24" Height="24">
                                <Path Data="M3 9v6h4l5 5V4L7 9H3z" Fill="{DynamicResource TextPrimaryBrush}"/>
                                <Path Data="M16 8.5a5 5 0 0 1 0 7" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                                <Path Data="M18.7 5.8a9 9 0 0 1 0 12.4" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" Opacity="0.5"/>
                            </Canvas>
                            <Canvas x:Name="AudioOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                <Path Data="M3 9v6h4l5 5V4L7 9H3z" Fill="{DynamicResource DangerBrush}"/>
                                <Path Data="M16 9l6 6M22 9l-6 6" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="AudioLabel" Text="Áudio" FontFamily="{DynamicResource FontBody}" FontSize="13" FontWeight="Medium"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Medidor decorativo (sem provider de nível real — reflete só o estado mutado do mic) -->
            <StackPanel x:Name="Meter" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="22" Margin="0,0,0,6">
                <Border x:Name="Bar1" Width="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource SuccessBrush}"/>
                <Border x:Name="Bar2" Width="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource SuccessBrush}"/>
                <Border x:Name="Bar3" Width="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource SuccessBrush}"/>
                <Border x:Name="Bar4" Width="3" CornerRadius="2" VerticalAlignment="Bottom" Margin="0,0,2,0" Background="{DynamicResource SuccessBrush}"/>
                <Border x:Name="Bar5" Width="3" CornerRadius="2" VerticalAlignment="Bottom" Background="{DynamicResource SuccessBrush}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
