<Window x:Class="Cortinho.Overlay.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual">
    <!--
        A janela é maior que a ilha: reserva uma faixa transparente em volta (12 nas laterais/rodapé,
        40 no topo) pro chrome do modo de edição (§9) — a tracejada fica 8 DIPs pra fora da ilha e o chip
        de rótulo 34 acima dela, ambos fora dos limites da ilha e portanto fora da janela se não houvesse
        essa folga (WPF recorta no limite da janela). De quebra, resolve o recorte da sombra elev-4
        (blur 40 / depth 14), que antes era cortada pela borda da janela.

        Quem traduz "posição da ilha" ⇄ "posição da janela" é SetIslandPosition/IslandLeft/IslandTop —
        o OverlayController raciocina sempre em coordenadas da ILHA, nunca da janela.
    -->
    <Grid>
        <Rectangle x:Name="EditRing" Margin="4,32,4,4" RadiusX="14" RadiusY="14"
                   Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <Border x:Name="IslandRoot"
                Margin="12,40,12,12"
                Background="{DynamicResource SurfaceOverlayOpaqueBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusLg}"
                Padding="16"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IslandScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="IslandTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5"/>
            </Border.Effect>
            <ContentControl x:Name="ContentHost" Focusable="False"/>
        </Border>

        <!-- Chip de rótulo (§9): 8 à esquerda e 34 acima do canto da ilha -->
        <Border x:Name="LabelChip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,6,0,0"
                Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="8,3,4,3"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LabelChipText" FontFamily="{DynamicResource FontBody}" FontSize="11"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <Border Width="20" Height="20" Margin="6,0,0,0">
                    <Viewbox Width="13" Height="13">
                        <Canvas Width="24" Height="24">
                            <Path Data="M14.279 2.152C13.909 2 13.439 2 12.5 2s-1.408 0-1.779.152a2 2 0 0 0-1.09 1.083c-.094.223-.13.484-.145.863a1.62 1.62 0 0 1-.796 1.353a1.64 1.64 0 0 1-1.579.008c-.338-.178-.583-.276-.825-.308a2.03 2.03 0 0 0-1.49.396c-.318.242-.553.646-1.022 1.453c-.47.807-.704 1.21-.757 1.605c-.07.526.074 1.058.4 1.479c.148.192.357.353.68.555c.477.297.783.803.783 1.361s-.306 1.064-.782 1.36c-.324.203-.533.364-.682.556a2 2 0 0 0-.399 1.479c.053.394.287.798.757 1.605s.704 1.21 1.022 1.453c.424.323.96.465 1.49.396c.242-.032.487-.13.825-.308a1.64 1.64 0 0 1 1.58.008c.486.28.774.795.795 1.353c.15.38.051.64.145.863c.204.49.596.88 1.09 1.083c.37.152.84.152 1.779.152s1.409 0 1.779-.152a2 2 0 0 0 1.09-1.083c.094-.223.13-.483.145-.863c.02-.558.309-1.074.796-1.353a1.64 1.64 0 0 1 1.579-.008c.338.178.583.276.825.308c.53.07 1.066-.073 1.49-.396c.318-.242.553-.646 1.022-1.453c.47-.807.704-1.21.757-1.605a2 2 0 0 0-.4-1.479c-.148-.192-.357-.353-.68-.555c-.477-.297-.783-.803-.783-1.361s.306-1.064.782-1.36c.324-.203.533-.364.682-.556a2 2 0 0 0 .399-1.479c-.053-.394-.287-.798-.757-1.605s-.704-1.21-1.022-1.453a2.03 2.03 0 0 0-1.49-.396c-.242.032-.487.13-.825.308a1.64 1.64 0 0 1-1.58-.008a1.62 1.62 0 0 1-.795-1.353c-.015-.38-.051-.64-.145-.863a2 2 0 0 0-1.09-1.083"
                                  Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Path Data="M15.523 12c0 1.657-1.354 3-3.023 3s-3.023-1.343-3.023-3S10.83 9 12.5 9s3.023 1.343 3.023 3"
                                  Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <Border Width="20" Height="20" CornerRadius="{DynamicResource RadiusSm}"
                        Background="{DynamicResource AccentBrush}">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path Data="m16.219 4.838l2.964 2.967c2.012 2.014 3.018 3.021 2.784 4.107c-.235 1.085-1.567 1.585-4.23 2.586l-1.845.693c-.713.268-1.07.402-1.345.64q-.181.158-.322.352c-.212.297-.313.664-.515 1.4c-.46 1.672-.69 2.508-1.239 2.821c-.23.132-.492.2-.758.2c-.63 0-1.243-.614-2.469-1.84l-1.466-1.468l-1.079-1.08L5.285 14.8c-1.218-1.219-1.827-1.828-1.83-2.455a1.53 1.53 0 0 1 .203-.773c.313-.543 1.143-.772 2.803-1.23c.737-.203 1.105-.304 1.402-.517q.199-.144.36-.332c.236-.278.368-.637.63-1.355l.669-1.823c.987-2.693 1.48-4.04 2.568-4.28s2.102.774 4.129 2.803"
                                  Opacity="0.5" Fill="{DynamicResource TextOnAccentBrush}"/>
                            <Path Data="m3.302 21.776l4.476-4.48l-1.079-1.08l-4.476 4.48a.764.764 0 0 0 1.08 1.08"
                                  Fill="{DynamicResource TextOnAccentBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
