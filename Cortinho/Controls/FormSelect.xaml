<UserControl x:Class="Cortinho.Controls.FormSelect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock x:Name="LabelBlock" FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <ComboBox x:Name="Combo" Style="{DynamicResource FormSelectStyle}" SelectionChanged="Combo_SelectionChanged"/>
    </StackPanel>
</UserControl>
