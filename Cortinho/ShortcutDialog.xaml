<Window x:Class="Cortinho.ShortcutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cortinho.Controls"
        Title="Atalho"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">

    <Border Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,16">
                <TextBlock x:Name="TitleText" Text="Adicionar atalho" FontFamily="{DynamicResource FontDisplaySemiBold}"
                           FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderSubtleBrush}"/>

            <StackPanel Grid.Row="1" Margin="18" >
                <controls:FormTextField x:Name="NameField" Label="Nome" Placeholder="Ex: Discord" Margin="0,0,0,14"/>

                <controls:FormSelect x:Name="TypeField" Label="Tipo" Margin="0,0,0,14" SelectionChanged="TypeField_SelectionChanged"/>

                <controls:FormTextField x:Name="PathField" Label="Caminho" Placeholder="C:\… ou https://…"/>

                <CheckBox x:Name="TrackDiscordCheck" Style="{StaticResource FormCheckBoxStyle}"
                          Content="Rastrear presença no Discord" Margin="0,14,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14">
                    <Button Content="Cancelar" Style="{StaticResource GhostButtonStyle}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="Salvar" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
