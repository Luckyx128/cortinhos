<Window x:Class="Cortinho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:Cortinho.Controls"
        Title="Cortinhos" Height="640" Width="920" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="Transparent"
        Closing="MainWindow_Closing"
        Activated="MainWindow_Activated"
        Deactivated="MainWindow_Deactivated"
        StateChanged="MainWindow_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="-1"
                             ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Fica aqui (não em Theme/Controls.xaml) porque o Click precisa resolver contra o code-behind
             desta janela — um ResourceDictionary solto não tem x:Class pra hospedar o handler. -->

        <!-- ContextMenu não é filho da árvore visual do Button — DataContext não desce sozinho,
             tem que amarrar explicitamente no PlacementTarget (gotcha clássico do WPF). -->
        <ContextMenu x:Key="TileContextMenu" x:Shared="false" Style="{StaticResource FormContextMenuStyle}"
                     DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="TileContextMenu_Opened">
            <MenuItem Header="Abrir" Style="{StaticResource FormMenuItemStyle}" Click="TileMenu_Open_Click">
                <MenuItem.Icon>
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M23 12c0-1.035-.53-2.07-1.591-2.647L8.597 2.385C6.534 1.264 4 2.724 4 5.033V12z" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Path Data="m8.597 21.615l12.812-6.968A2.99 2.99 0 0 0 23 12H4v6.967c0 2.31 2.534 3.769 4.597 2.648" Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Editar" Style="{StaticResource FormMenuItemStyle}" Click="TileMenu_Edit_Click">
                <MenuItem.Icon>
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3.25 22a.75.75 0 0 1 .75-.75h16a.75.75 0 0 1 0 1.5H4a.75.75 0 0 1-.75-.75" Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Path Data="M19.08 7.372a3.147 3.147 0 0 0-4.45-4.45l-.71.71l.031.089c.26.75.751 1.733 1.675 2.656a7 7 0 0 0 2.745 1.705z" Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Path Data="m13.951 3.6l-.03.03l.03.09c.26.75.75 1.732 1.674 2.656A7 7 0 0 0 18.37 8.08l-6.85 6.85c-.462.462-.693.693-.948.891q-.452.352-.969.6c-.291.138-.601.241-1.22.448l-3.268 1.09a.849.849 0 0 1-1.073-1.074l1.089-3.268c.206-.62.31-.93.448-1.22q.247-.518.6-.97c.198-.254.429-.485.89-.947z" Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Tag="pin" Header="Fixar" Style="{StaticResource FormMenuItemStyle}" Click="TileMenu_TogglePin_Click">
                <MenuItem.Icon>
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="m16.219 4.838l2.964 2.967c2.012 2.014 3.018 3.021 2.784 4.107c-.235 1.085-1.567 1.585-4.23 2.586l-1.845.693c-.713.268-1.07.402-1.345.64q-.181.158-.322.352c-.212.297-.313.664-.515 1.4c-.46 1.672-.69 2.508-1.239 2.821c-.23.132-.492.2-.758.2c-.63 0-1.243-.614-2.469-1.84l-1.466-1.468l-1.079-1.08L5.285 14.8c-1.218-1.219-1.827-1.828-1.83-2.455a1.53 1.53 0 0 1 .203-.773c.313-.543 1.143-.772 2.803-1.23c.737-.203 1.105-.304 1.402-.517q.199-.144.36-.332c.236-.278.368-.637.63-1.355l.669-1.823c.987-2.693 1.48-4.04 2.568-4.28s2.102.774 4.129 2.803" Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Path Data="m3.302 21.776l4.476-4.48l-1.079-1.08l-4.476 4.48a.764.764 0 0 0 1.08 1.08" Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="4,4"/>
            <MenuItem Header="Remover" Style="{StaticResource FormMenuItemStyle}" Tag="danger" Click="TileMenu_Remove_Click">
                <MenuItem.Icon>
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="M3 6.386c0-.484.345-.877.771-.877h2.665c.529-.016.996-.399 1.176-.965l.03-.1l.115-.391c.07-.24.131-.45.217-.637c.338-.739.964-1.252 1.687-1.383c.184-.033.378-.033.6-.033h3.478c.223 0 .417 0 .6.033c.723.131 1.35.644 1.687 1.383c.086.187.147.396.218.637l.114.391l.03.1c.18.566.74.95 1.27.965h2.57c.427 0 .772.393.772.877s-.345.877-.771.877H3.77c-.425 0-.77-.393-.77-.877" Fill="{DynamicResource DangerBrush}"/>
                            <Path Data="M11.596 22h.808c2.783 0 4.174 0 5.08-.886c.904-.886.996-2.339 1.181-5.245l.267-4.188c.1-1.577.15-2.366-.303-2.865c-.454-.5-1.22-.5-2.753-.5H8.124c-1.533 0-2.3 0-2.753.5s-.404 1.288-.303 2.865l.267 4.188c.185 2.906.277 4.36 1.182 5.245c.905.886 2.296.886 5.079.886" Opacity="0.5" Fill="{DynamicResource DangerBrush}"/>
                        </Canvas>
                    </Viewbox>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="ShortcutTileTemplate">
            <Button Style="{StaticResource ShortcutTileButtonStyle}" Click="ShortcutTile_Click"
                    ContextMenu="{StaticResource TileContextMenu}" ContextMenuOpening="ShortcutTile_ContextMenuOpening"/>
        </DataTemplate>
    </Window.Resources>

    <!-- Cantos reais são arredondados pelo DWM (DWMWA_WINDOW_CORNER_PREFERENCE, ver MainWindow.xaml.cs) —
         esse CornerRadius/Border é só o contorno visual 1px que acompanha o foco de janela. -->
    <Border x:Name="WindowBorder" CornerRadius="{DynamicResource RadiusLg}" BorderThickness="1"
            BorderBrush="{DynamicResource BorderSubtleBrush}" Background="{DynamicResource BgWindowBrush}">
        <Border x:Name="MaximizePad" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- title row + tab row: opacidade esmaece junto quando a janela perde foco -->
                <StackPanel x:Name="TitleTabWrapper" Grid.Row="0">

                    <Grid Height="44" Background="{DynamicResource MaterialMicaBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <Viewbox Width="24" Height="24">
                                <Canvas Width="128" Height="128">
                                    <Canvas.Resources>
                                        <DrawingBrush x:Key="LogoStripes" TileMode="Tile" Viewport="0,0,28.16,128" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="#FF3EA6FF" Geometry="M0,0 H14.08 V128 H0 Z"/>
                                                    <GeometryDrawing Brush="#FF2F8FE0" Geometry="M14.08,0 H28.16 V128 H14.08 Z"/>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Canvas.Resources>
                                    <Path Data="M0,28 A28,28 0 0 1 28,0 H100 A28,28 0 0 1 128,28 V100 A28,28 0 0 1 100,128 H28 A28,28 0 0 1 0,100 Z" Fill="{StaticResource LogoStripes}"/>
                                    <Path Data="M24 0 H104 V20 a26 26 0 0 1 -26 26 H50 a26 26 0 0 1 -26 -26 Z" Fill="#FF14171C"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource FontDisplay}" FontWeight="Bold" FontSize="19">
                                <Run Text="cor" Foreground="{DynamicResource TextPrimaryBrush}"/><Run Text="tinhos" Foreground="{DynamicResource AccentBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1" Margin="16,0,0,0" Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="{DynamicResource RadiusLg}" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleHotkeyBadge" Text="Ctrl+Alt+L" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>

                        <Border Grid.Column="2" Margin="6,0,0,0" Background="{DynamicResource Surface3Brush}"
                                CornerRadius="{DynamicResource RadiusLg}" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="CountBadgeText" Text="0 atalhos" FontFamily="{DynamicResource FontBody}"
                                       FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:ThemeToggleControl VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click">
                                <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1" Data="M0,5 H10"/>
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeButton_Click">
                                <Grid Width="10" Height="10">
                                    <Path x:Name="MaximizeGlyph" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"/>
                                    <Path x:Name="RestoreGlyph" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1"
                                          Data="M2,2 H8 V8 H2 Z M2,2 V0.5 H9.5 V7.5 H8" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButtonStyle}" Click="CloseButton_Click">
                                <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1" Data="M0,0 L10,10 M10,0 L0,10"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Height="41" Background="{DynamicResource MaterialMicaBrush}" Margin="0,-1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <RadioButton x:Name="AtalhosTab" Grid.Column="0" GroupName="MainTab" Style="{StaticResource TabButtonStyle}"
                                     Content="Atalhos" Margin="16,0,0,12" VerticalAlignment="Center"
                                     Checked="AtalhosTab_Checked"/>
                        <RadioButton x:Name="ConfigTab" Grid.Column="1" GroupName="MainTab" Style="{StaticResource TabButtonStyle}"
                                     Content="Config" Margin="4,0,0,12" VerticalAlignment="Center"
                                     Checked="ConfigTab_Checked"/>

                        <Border x:Name="SearchBoxWrapper" Grid.Column="3" Width="240" Height="30" Margin="0,0,20,12" VerticalAlignment="Center"
                                CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0" Width="15" Height="15" Margin="8,0,4,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M20.313 11.157a9.157 9.157 0 1 1-18.313 0a9.157 9.157 0 0 1 18.313 0" Opacity="0.5" Fill="{DynamicResource TextTertiaryBrush}"/>
                                        <Path Data="m17.1 18.122l3.666 3.666a.723.723 0 0 0 1.023-1.022L18.122 17.1a9 9 0 0 1-1.022 1.022" Fill="{DynamicResource TextTertiaryBrush}"/>
                                    </Canvas>
                                </Viewbox>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="SearchPlaceholder" Text="Buscar atalho…" Foreground="{DynamicResource TextTertiaryBrush}"
                                               FontFamily="{DynamicResource FontBody}" FontSize="13" IsHitTestVisible="False" Margin="0,0,10,0"/>
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource FontBody}" FontSize="13"
                                             VerticalContentAlignment="Center" Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Atalhos: grid de tiles -->
                <ScrollViewer x:Name="GridScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ShortcutsGrid" Margin="24" ItemTemplate="{StaticResource ShortcutTileTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Config (fase 5) -->
                <ScrollViewer x:Name="ConfigPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="520" Margin="24" HorizontalAlignment="Left">

                        <TextBlock Text="Discord Rich Presence" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="DiscordEnabledCheck" Style="{StaticResource FormCheckBoxStyle}"
                                  Content="Ativar Rich Presence quando um jogo rastreado estiver rodando"
                                  Checked="DiscordEnabledCheck_Changed" Unchecked="DiscordEnabledCheck_Changed"/>
                        <controls:FormTextField x:Name="DiscordClientIdField" Label="Client ID" Margin="0,12,0,0"/>

                        <TextBlock Text="Hotkey global" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Abrir/fechar o launcher" FontFamily="{DynamicResource FontBody}" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource RadiusLg}"
                                    Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="ConfigHotkeyBadge" Text="Ctrl+Alt+L" FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <Button x:Name="RegravarButton" Content="Regravar" Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0" Click="RegravarButton_Click"/>
                        </StackPanel>

                        <TextBlock Text="Notch" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:FormSelect x:Name="NotchAnchorField" Grid.Column="0" Label="Âncora" SelectionChanged="NotchAnchorField_SelectionChanged"/>
                            <controls:FormSelect x:Name="NotchMonitorField" Grid.Column="2" Label="Monitor" SelectionChanged="NotchMonitorField_SelectionChanged"/>
                        </Grid>

                        <TextBlock Text="Bandeja" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,12"/>
                        <TextBlock FontFamily="{DynamicResource FontBody}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="20">
                            Fechar a janela (X) só minimiza pra bandeja. Use <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Sair</Run> no menu da bandeja pra encerrar de verdade.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- tray strip -->
                <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        Background="{DynamicResource BgWindowBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Grid.Column="0" Text="Pronto" FontFamily="{DynamicResource FontMono}"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Width="28" Height="28" CornerRadius="{DynamicResource RadiusSm}"
                                Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                ToolTip="Ícone da bandeja">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="m10.667 6.134l-.502-.355A4.24 4.24 0 0 0 7.715 5h-.612c-.405 0-.813.025-1.194.16c-2.383.846-4.022 3.935-3.903 10.943c.024 1.412.354 2.972 1.628 3.581A3.2 3.2 0 0 0 5.027 20a2.74 2.74 0 0 0 1.53-.437c.41-.268.77-.616 1.13-.964c.444-.43.888-.86 1.424-1.138a4.1 4.1 0 0 1 1.89-.461H13c.658 0 1.306.158 1.89.46c.536.279.98.709 1.425 1.139c.36.348.72.696 1.128.964c.39.256.895.437 1.531.437a3.2 3.2 0 0 0 1.393-.316c1.274-.609 1.604-2.17 1.628-3.581c.119-7.008-1.52-10.097-3.903-10.942C17.71 5.025 17.3 5 16.897 5h-.612a4.24 4.24 0 0 0-2.45.78l-.502.354a2.31 2.31 0 0 1-2.666 0" Opacity="0.5" Fill="{DynamicResource TextSecondaryBrush}"/>
                                    <Path Data="M16.75 9a.75.75 0 1 1 0 1.5a.75.75 0 0 1 0-1.5m-9.25.25a.75.75 0 0 1 .75.75v.75H9a.75.75 0 0 1 0 1.5h-.75V13a.75.75 0 0 1-1.5 0v-.75H6a.75.75 0 0 1 0-1.5h.75V10a.75.75 0 0 1 .75-.75m11.5 2a.75.75 0 1 1-1.5 0a.75.75 0 0 1 1.5 0m-3.75.75a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m2.25.75a.75.75 0 1 0-1.5 0a.75.75 0 0 0 1.5 0" Fill="{DynamicResource TextSecondaryBrush}"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
