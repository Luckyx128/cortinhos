<Window x:Class="Cortinho.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cortinho"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Title="Notch" Height="36" Width="92">
    <Border x:Name="NotchRoot"
        CornerRadius="{DynamicResource RadiusNotch}"
        Background="{DynamicResource NotchFillBrush}"
        BorderBrush="{DynamicResource BorderSubtleBrush}"
        BorderThickness="1,0,1,1"
        RenderTransformOrigin="0.5,0.5"
        MouseMove="NotchRoot_MouseMove"
        MouseEnter="NotchRoot_MouseEnter"
        MouseLeave="NotchRoot_MouseLeave"
        PreviewMouseLeftButtonDown="NotchRoot_PreviewMouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect
                x:Name="NotchShadow"
                BlurRadius="16"
                ShadowDepth="2"
                Opacity="0.34"
                Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid x:Name="CompactContent">
            <StackPanel
            x:Name="SlotsRow"
            Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Border MinWidth="30" Height="30" CornerRadius="4" Padding="7,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Canvas x:Name="MicOnIcon" Width="24" Height="24">
                                    <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                    <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9"
                  Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Canvas x:Name="MicOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                  Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="MicCaption"
                   FontFamily="{DynamicResource FontBody}"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="MicUnderline"
                            Width="12" Height="3" CornerRadius="2"
                            Background="{DynamicResource DangerBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="3,0,0,2"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="DiscordSlot" MinWidth="30" Height="30" CornerRadius="4" Padding="7,0" Margin="4,0,0,0" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="DiscordSlotBody" Opacity="0.5"
                                          Data="M10.667 6.134l-.502-.355A4.24 4.24 0 0 0 7.715 5h-.612c-.405 0-.813.025-1.194.16c-2.383.846-4.022 3.935-3.903 10.943c.024 1.412.354 2.972 1.628 3.581A3.2 3.2 0 0 0 5.027 20a2.74 2.74 0 0 0 1.53-.437c.41-.268.77-.616 1.13-.964c.444-.43.888-.86 1.424-1.138a4.1 4.1 0 0 1 1.89-.461H13c.658 0 1.306.158 1.89.46c.536.279.98.709 1.425 1.139c.36.348.72.696 1.128.964c.39.256.895.437 1.531.437a3.2 3.2 0 0 0 1.393-.316c1.274-.609 1.604-2.17 1.628-3.581c.119-7.008-1.52-10.097-3.903-10.942C17.71 5.025 17.3 5 16.897 5h-.612a4.24 4.24 0 0 0-2.45.78l-.502.354a2.31 2.31 0 0 1-2.666 0"
                                          Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Path x:Name="DiscordSlotDetail"
                                          Data="M16.75 9a.75.75 0 1 1 0 1.5a.75.75 0 0 1 0-1.5m-9.25.25a.75.75 0 0 1 .75.75v.75H9a.75.75 0 0 1 0 1.5h-.75V13a.75.75 0 0 1-1.5 0v-.75H6a.75.75 0 0 1 0-1.5h.75V10a.75.75 0 0 1 .75-.75m11.5 2a.75.75 0 1 1-1.5 0a.75.75 0 0 1 1.5 0m-3.75.75a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m2.25.75a.75.75 0 1 0-1.5 0a.75.75 0 0 0 1.5 0"
                                          Fill="{DynamicResource TextTertiaryBrush}"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="DiscordCaption"
                   FontFamily="{DynamicResource FontBody}"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Text="Discord"
                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="DiscordSlotUnderline"
                            Width="12" Height="3" CornerRadius="2"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="3,0,0,2"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Border x:Name="NotificationSlot" MinWidth="30" Height="30" CornerRadius="4" Padding="7,0" Margin="4,0,0,0" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Opacity="0.5"
                                          Data="M18.75 9v.704c0 .845.24 1.671.692 2.374l1.108 1.723c1.011 1.574.239 3.713-1.52 4.21a25.8 25.8 0 0 1-14.06 0c-1.759-.497-2.531-2.636-1.52-4.21l1.108-1.723a4.4 4.4 0 0 0 .693-2.374V9c0-3.866 3.022-7 6.749-7s6.75 3.134 6.75 7"
                                          Fill="{DynamicResource TextTertiaryBrush}"/>
                                    <Path Data="M7.243 18.545a5.002 5.002 0 0 0 9.513 0c-3.145.59-6.367.59-9.513 0"
                                          Fill="{DynamicResource TextTertiaryBrush}"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="NotificationCaption"
                   FontFamily="{DynamicResource FontBody}"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="NotificationBadge"
                            Background="{DynamicResource AccentBrush}" CornerRadius="7.5" MinWidth="15" Height="15"
                            Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-6,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="NotificationBadgeText" Text="1"
                                   FontFamily="{DynamicResource FontMono}" FontWeight="Bold" FontSize="9.5"
                                   Foreground="{DynamicResource TextOnAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            </StackPanel>

            <Border x:Name="StatusLabel" Visibility="Collapsed" CornerRadius="{DynamicResource RadiusNotch}" Padding="6,0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    MouseLeftButtonDown="StatusLabel_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                        <Grid Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="StatusIconPath"/>
                                <Path x:Name="StatusIconPathSecondary"/>
                            </Canvas>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="StatusLabelText"
                               FontFamily="{DynamicResource FontBody}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Border>
            </Grid>

            <Grid x:Name="StatusProgressBar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Surface3Brush}" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="StatusProgressFillCol" Width="0*"/>
                    <ColumnDefinition x:Name="StatusProgressEmptyCol" Width="100*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource AccentBrush}"/>
            </Grid>

            <StackPanel x:Name="ExpandedContent" Visibility="Collapsed" Margin="12">

                <StackPanel x:Name="TopStatusRow" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="{DynamicResource NotchFillBrush}"
            CornerRadius="{DynamicResource RadiusSm}" Padding="10,0" Height="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Grid Width="24" Height="24">
                                    <Canvas x:Name="TopMicOnIcon" Width="24" Height="24">
                                        <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                        <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9"
                              Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                    <Canvas x:Name="TopMicOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                        <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                              Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="TopMicCaption" Text="Mic ativo"
                       FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TopDiscordPill" Visibility="Collapsed" Margin="6,0,0,0"
            Background="{DynamicResource NotchFillBrush}"
            CornerRadius="{DynamicResource RadiusSm}" Padding="10,0" Height="30">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Grid Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Opacity="0.5"
                              Data="M10.667 6.134l-.502-.355A4.24 4.24 0 0 0 7.715 5h-.612c-.405 0-.813.025-1.194.16c-2.383.846-4.022 3.935-3.903 10.943c.024 1.412.354 2.972 1.628 3.581A3.2 3.2 0 0 0 5.027 20a2.74 2.74 0 0 0 1.53-.437c.41-.268.77-.616 1.13-.964c.444-.43.888-.86 1.424-1.138a4.1 4.1 0 0 1 1.89-.461H13c.658 0 1.306.158 1.89.46c.536.279.98.709 1.425 1.139c.36.348.72.696 1.128.964c.39.256.895.437 1.531.437a3.2 3.2 0 0 0 1.393-.316c1.274-.609 1.604-2.17 1.628-3.581c.119-7.008-1.52-10.097-3.903-10.942C17.71 5.025 17.3 5 16.897 5h-.612a4.24 4.24 0 0 0-2.45.78l-.502.354a2.31 2.31 0 0 1-2.666 0"
                              Fill="{DynamicResource AccentBrush}"/>
                                        <Path Data="M16.75 9a.75.75 0 1 1 0 1.5a.75.75 0 0 1 0-1.5m-9.25.25a.75.75 0 0 1 .75.75v.75H9a.75.75 0 0 1 0 1.5h-.75V13a.75.75 0 0 1-1.5 0v-.75H6a.75.75 0 0 1 0-1.5h.75V10a.75.75 0 0 1 .75-.75m11.5 2a.75.75 0 1 1-1.5 0a.75.75 0 0 1 1.5 0m-3.75.75a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m2.25.75a.75.75 0 1 0-1.5 0a.75.75 0 0 0 1.5 0"
                              Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="TopDiscordCaption" Text="Discord"
                       FontFamily="{DynamicResource FontBody}" FontSize="11" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Top">
                <Border x:Name="MicToggleButton"
        Height="36"
        CornerRadius="4"
        Padding="10,0"
        Cursor="Hand"
        MouseLeftButtonDown="MicToggleButton_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource NotchFillBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="16" Height="16">
                            <Grid Width="24" Height="24">
                                <Canvas x:Name="MicToggleOnIcon" Width="24" Height="24">
                                    <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"/>
                                    <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Canvas x:Name="MicToggleOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                          Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <TextBlock x:Name="MicToggleLabel" Grid.Column="1" Text="Mutar mic"
                   FontFamily="{DynamicResource FontBody}"
                   FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center" Margin="9,0,0,0"/>

                        <TextBlock x:Name="MicToggleState" Grid.Column="2" Text="ON"
                   FontFamily="{DynamicResource FontMono}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="ShortcutsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="ATALHOS RÁPIDOS" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ShortcutsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="38" Height="38" CornerRadius="4" Margin="0,0,6,0"
                                        Cursor="Hand" ToolTip="{Binding Name}"
                                        MouseLeftButtonDown="ShortcutButton_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource NotchFillBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Viewbox Width="17" Height="17">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding IconLayer1}" Opacity="{Binding IconLayer1Opacity}" Fill="{DynamicResource AccentBrush}"/>
                                            <Path Data="{Binding IconLayer2}" Opacity="{Binding IconLayer2Opacity}" Fill="{DynamicResource AccentBrush}"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NotificationsPanel" Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="NOTIFICAÇÕES" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClearNotificationsLink" Text="Limpar" FontFamily="{DynamicResource FontBody}" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="ClearNotifications_Click"/>
                    </Grid>

                    <ItemsControl x:Name="NotificationsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="9,7" CornerRadius="{DynamicResource RadiusSm}"
                                        Background="{DynamicResource Surface2Brush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3"
                                                Background="#33FFFFFF" Margin="0,1,8,0" VerticalAlignment="Top">
                                            <Image Source="{Binding Icon}" Width="14" Height="14"
                                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                           FontFamily="{DynamicResource FontBody}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TimeLabel}"
                                                           FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="6,0,0,0"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Body}" FontFamily="{DynamicResource FontBody}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoNotificationsLabel" Text="Sem notificações" FontFamily="{DynamicResource FontBody}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="PerfPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="10,8" CornerRadius="{DynamicResource RadiusSm}"
                            Background="{DynamicResource NotchFillBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CPU" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="CpuValueText" Text="—" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,6"/>
                            <Grid Height="2" Background="#22FFFFFF">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CpuBarFillCol" Width="0*"/>
                                    <ColumnDefinition x:Name="CpuBarEmptyCol" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CpuBarFill" Grid.Column="0" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,0,0" Padding="10,8" CornerRadius="{DynamicResource RadiusSm}"
                            Background="{DynamicResource NotchFillBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GPU" FontFamily="{DynamicResource FontMono}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            <TextBlock x:Name="GpuValueText" Text="—" FontFamily="{DynamicResource FontDisplaySemiBold}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,6"/>
