<Window x:Class="Cortinho.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cortinho"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Title="Notch" Height="48" Width="92">
    <Border x:Name="NotchRoot"
        CornerRadius="0,0,8,8"
        Background="#C7202020"
        BorderBrush="#14FFFFFF"
        BorderThickness="1,0,1,1"
        RenderTransformOrigin="0.5,0.5"
        MouseEnter="NotchRoot_MouseEnter"
        MouseLeave="NotchRoot_MouseLeave"
        PreviewMouseLeftButtonDown="NotchRoot_PreviewMouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect 
                x:Name="NotchShadow"
                BlurRadius="16" 
                ShadowDepth="2" 
                Opacity="0.34"
                Color="Black"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Border MinWidth="40" Height="40" CornerRadius="4" Padding="9,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Viewbox Width="22" Height="22">
                            <Grid Width="24" Height="24">
                                <Canvas x:Name="MicOnIcon" Width="24" Height="24">
                                    <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z"
                  Stroke="#FFECEEF2" StrokeThickness="1.5"/>
                                    <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9"
                  Stroke="#FFECEEF2" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Canvas x:Name="MicOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                  Stroke="#FFF0503C" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="MicCaption"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#FF9AA3AD"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="MicUnderline"
                            Width="24" Height="3" CornerRadius="2"
                            Background="#FFF0503C"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
