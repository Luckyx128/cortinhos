<Window x:Class="Cortinho.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cortinho"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Title="Notch" Height="36" Width="92">
    <Border x:Name="NotchRoot"
        CornerRadius="0,0,6,6"
        Background="#FF202020"
        BorderBrush="#14FFFFFF"
        BorderThickness="1,0,1,1"
        RenderTransformOrigin="0.5,0.5"
        MouseMove="NotchRoot_MouseMove"
        MouseEnter="NotchRoot_MouseEnter"
        MouseLeave="NotchRoot_MouseLeave"
        PreviewMouseLeftButtonDown="NotchRoot_PreviewMouseLeftButtonDown">
        <Border.RenderTransform>
            <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect 
                x:Name="NotchShadow"
                BlurRadius="16" 
                ShadowDepth="2" 
                Opacity="0.34"
                Color="Black"/>
        </Border.Effect>
        <Grid>
            <StackPanel  
            x:Name="CompactContent"
            Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <Border MinWidth="30" Height="30" CornerRadius="4" Padding="7,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Canvas x:Name="MicOnIcon" Width="24" Height="24">
                                    <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z"
                  Stroke="#FFECEEF2" StrokeThickness="1.5"/>
                                    <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9"
                  Stroke="#FFECEEF2" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Canvas x:Name="MicOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                  Stroke="#FFF0503C" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="MicCaption"
                   FontSize="11"
                   FontWeight="Medium"
                   Foreground="#FF9AA3AD"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"
                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Border x:Name="MicUnderline"
                            Width="12" Height="3" CornerRadius="2"
                            Background="#FFF0503C"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="3,0,0,2"
                            Visibility="Collapsed"/>
                </Grid>
            </Border>
        </StackPanel>
            <Grid x:Name="ExpandedContent" Visibility="Collapsed" Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Top">
                <Border x:Name="MicToggleButton"
        Height="36"
        CornerRadius="4"
        Padding="10,0"
        Cursor="Hand"
        MouseLeftButtonDown="MicToggleButton_Click">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF202020"/>
                            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="16" Height="16">
                            <Grid Width="24" Height="24">
                                <Canvas x:Name="MicToggleOnIcon" Width="24" Height="24">
                                    <Path Data="M17 7v4a5 5 0 0 1-10 0V7a5 5 0 0 1 10 0Z" Stroke="#FFECEEF2" StrokeThickness="1.5"/>
                                    <Path Data="M17 7h-3m3 4h-3m6 0a8 8 0 0 1-8 8m0 0a8 8 0 0 1-8-8m8 8v3m0 0h3m-3 0H9" Stroke="#FFECEEF2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <Canvas x:Name="MicToggleOffIcon" Width="24" Height="24" Visibility="Collapsed">
                                    <Path Data="m2 2l20 20M4 11a8 8 0 0 0 8 8m0 0c1.954 0 3.745-.7 5.135-1.865M12 19v3m0 0h3m-3 0H9m11-11c0 1.651-.5 3.186-1.358 4.46m-1.634-8.464c0-2.761-2.239-4.98-5-4.98c-1.869 0-3.47.965-4.328 2.484m9.328 2.496l-3.028.012m3.028-.012v4.008m-10-4.008v4.02a5 5 0 0 0 5 5c1.135 0 2.165-.39 3.004-1.028m1.435-1.728c.358-.69.56-1.413.56-2.244v-.012m-2.824 0h2.825"
                          Stroke="#FFF0503C" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <TextBlock x:Name="MicToggleLabel" Grid.Column="1" Text="Mutar mic"
                   FontSize="13" FontWeight="Medium" Foreground="#FFECEEF2"
                   VerticalAlignment="Center" Margin="9,0,0,0"/>

                        <TextBlock x:Name="MicToggleState" Grid.Column="2" Text="ON"
                   FontFamily="Consolas" FontSize="11" Foreground="#FF9AA3AD"
                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="ShortcutsPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="ATALHOS RÁPIDOS" FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="ShortcutsItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="38" Height="38" CornerRadius="4" Margin="0,0,6,0"
                                        Cursor="Hand" ToolTip="{Binding Name}"
                                        MouseLeftButtonDown="ShortcutButton_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF202020"/>
                                            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Viewbox Width="17" Height="17">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{Binding IconGeometry}" Stroke="#FF6EA8FE" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NotificationsPanel" Grid.Row="0" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="NOTIFICAÇÕES" FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ClearNotificationsLink" Text="Limpar" FontSize="10.5" Foreground="#FF6EA8FE"
                                   HorizontalAlignment="Right" Cursor="Hand" MouseLeftButtonDown="ClearNotifications_Click"/>
                    </Grid>

                    <ItemsControl x:Name="NotificationsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="18" Height="18" CornerRadius="3"
                                            Background="#33FFFFFF" Margin="0,1,8,0" VerticalAlignment="Top">
                                        <Image Source="{Binding Icon}" Width="14" Height="14"
                                               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="#FFECEEF2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeLabel}"
                                                       FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD"
                                                       Margin="6,0,0,0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Body}" FontSize="11" Foreground="#FF9AA3AD"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="NoNotificationsLabel" Text="Sem notificações" FontSize="11" Foreground="#FF9AA3AD" Visibility="Collapsed"/>
                </StackPanel>

                <Grid x:Name="PerfPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="10,8" CornerRadius="4"
                            Background="#FF202020" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CPU" FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD"/>
                            <TextBlock x:Name="CpuValueText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="#FFECEEF2" Margin="0,2,0,6"/>
                            <Grid Height="2" Background="#22FFFFFF">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="CpuBarFillCol" Width="0*"/>
                                    <ColumnDefinition x:Name="CpuBarEmptyCol" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CpuBarFill" Grid.Column="0" CornerRadius="1" Background="#FF6EA8FE"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,0,0" Padding="10,8" CornerRadius="4"
                            Background="#FF202020" BorderBrush="#14FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="GPU" FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD"/>
                            <TextBlock x:Name="GpuValueText" Text="—" FontSize="15" FontWeight="SemiBold" Foreground="#FFECEEF2" Margin="0,2,0,6"/>
                            <Grid Height="2" Background="#22FFFFFF">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GpuBarFillCol" Width="0*"/>
                                    <ColumnDefinition x:Name="GpuBarEmptyCol" Width="100*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="GpuBarFill" Grid.Column="0" CornerRadius="1" Background="#FF6EA8FE"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DiscordPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0"
                        Padding="10,8" CornerRadius="4" Background="#FF202020" BorderBrush="#14FFFFFF" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Viewbox Grid.Column="0" Width="16" Height="16" Margin="0,0,9,0">
                            <Grid Width="24" Height="24">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M6 15a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4l1 3a2 2 0 0 1-3.2 2.2L14 18h-4l-1.8 2.2A2 2 0 0 1 5 18Z"
                                          Stroke="#FF9AA3AD" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    <Path Data="M8.5 11.5v3 M7 13h3" Stroke="#FF9AA3AD" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                    <Path Data="M15.2 12.2h.01 M17.2 14.2h.01" Stroke="#FF9AA3AD" StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Grid>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="DISCORD RICH PRESENCE" FontFamily="Consolas" FontSize="9.5" Foreground="#FF9AA3AD"/>
                            <TextBlock x:Name="DiscordValueText" Text="Desativado" FontSize="13" FontWeight="SemiBold" Foreground="#FFECEEF2" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Border x:Name="DiscordToggleTrack" Grid.Column="2" Width="34" Height="20" CornerRadius="10"
                                Background="#3A3A3A" Cursor="Hand" VerticalAlignment="Center"
                                MouseLeftButtonDown="DiscordToggle_Click">
                            <Border x:Name="DiscordToggleKnob" Width="16" Height="16" CornerRadius="8" Background="White"
                                    HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
