<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cores — valores de design_handoff_notch/TOKENS-WPF.md, dark (único tema implementado) -->
    <SolidColorBrush x:Key="Surface2Brush" Color="#FF232A33"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#FF2B333D"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFECEEF2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9AA3AD"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6B7480"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FF0A1119"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF0503C"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26F0503C"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#1FFFFFFF"/>

    <!--
        Fill do notch — divergência consciente registrada em PHASE-1-NOTCH.md/IMPLEMENTATION-STATUS-NOTCH.md:
        o spec pede rgba(32,32,32,.78) + acrylic; testado e revertido (WS_EX_NOACTIVATE impede blur ao vivo do DWM,
        e o usuário pediu opaco em vez do translúcido). Centralizado aqui pra não precisar mudar em 6 lugares se
        essa decisão for revisitada.
    -->
    <SolidColorBrush x:Key="NotchFillBrush" Color="#FF202020"/>

    <!--
        Accent — sobrescrito em runtime por App.xaml.cs lendo UISettings.GetColorValue(UIColorType.Accent)
        (accent real do Windows do usuário). Os valores abaixo são só o fallback "brand accent" (dark) até isso rodar.
    -->
    <Color x:Key="AccentColor">#FF3EA6FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <Color x:Key="AccentSoftColor">#243EA6FF</Color>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}"/>
    <Color x:Key="AccentHoverColor">#FF6EBEFF</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}"/>

    <!-- Raios -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <!-- Spec pede "0 0 8 8"; implementado como "0 0 6 6" (bate com o checklist de aceite da seção 9, que diverge do corpo da seção 3 do próprio spec). -->
    <CornerRadius x:Key="RadiusNotch">0,0,6,6</CornerRadius>

    <!-- Tipografia — famílias custom embutidas em Fonts/ (design_handoff_notch/reference/assets/fonts).
         Chakra Petch e IBM Plex Mono têm faces estáticas por peso (não sintetizar peso via FontWeight nelas,
         referenciar a face certa) — ver aviso em TOKENS-WPF.md. IBM Plex Sans é variável, aceita FontWeight normal. -->
    <!-- "Chakra Petch" tem Regular+Bold ligados na mesma família (use FontWeight="Bold" pra pegar o Bold de verdade); Medium/SemiBold são famílias próprias. -->
    <FontFamily x:Key="FontDisplay">./Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="FontDisplayMedium">./Fonts/#Chakra Petch Medium</FontFamily>
    <FontFamily x:Key="FontDisplaySemiBold">./Fonts/#Chakra Petch SemiBold</FontFamily>

    <FontFamily x:Key="FontBody">./Fonts/#IBM Plex Sans</FontFamily>

    <FontFamily x:Key="FontMono">./Fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="FontMonoMedium">./Fonts/#IBM Plex Mono Medium</FontFamily>
    <FontFamily x:Key="FontMonoSemiBold">./Fonts/#IBM Plex Mono SemiBold</FontFamily>

</ResourceDictionary>
