<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tokens que NÃO mudam entre dark/light (fase 6) — raios, fontes, gradientes de conteúdo dos
         tiles (são sobre o tipo de atalho, não sobre o tema) e o vermelho fixo do close da caption
         ("não muda no light theme", TOKENS-WPF.md §Caption buttons). Cor de superfície/texto/etc fica
         em Tokens.Dark.xaml / Tokens.Light.xaml — troca em runtime via Services/ThemeService.cs. -->

    <!-- Caption buttons — close é vermelho fixo do sistema em qualquer tema -->
    <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="CaptionClosePressBrush" Color="#FFB2231A"/>

    <!-- Gradientes de capa do ShortcutTile por tipo (150deg, top-left -> bottom-right) -->
    <LinearGradientBrush x:Key="TileGradientAppBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1F4A73" Offset="0"/>
        <GradientStop Color="#FF132B45" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileGradientFolderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF6A4A12" Offset="0"/>
        <GradientStop Color="#FF3A2A10" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileGradientUrlBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF12564A" Offset="0"/>
        <GradientStop Color="#FF0F3330" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TileGradientCommandBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3D2F5E" Offset="0"/>
        <GradientStop Color="#FF241A38" Offset="1"/>
    </LinearGradientBrush>

    <!-- Raios -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!-- Spec pede "0 0 8 8"; implementado como "0 0 6 6" (bate com o checklist de aceite da seção 9, que diverge do corpo da seção 3 do próprio spec). -->
    <CornerRadius x:Key="RadiusNotch">0,0,6,6</CornerRadius>

    <!-- Tipografia — famílias custom embutidas em Fonts/ (design_handoff_notch/reference/assets/fonts).
         Chakra Petch e IBM Plex Mono têm faces estáticas por peso (não sintetizar peso via FontWeight nelas,
         referenciar a face certa) — ver aviso em TOKENS-WPF.md. IBM Plex Sans é variável, aceita FontWeight normal. -->
    <!-- "Chakra Petch" tem Regular+Bold ligados na mesma família (use FontWeight="Bold" pra pegar o Bold de verdade); Medium/SemiBold são famílias próprias. -->
    <FontFamily x:Key="FontDisplay">./Fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="FontDisplayMedium">./Fonts/#Chakra Petch Medium</FontFamily>
    <FontFamily x:Key="FontDisplaySemiBold">./Fonts/#Chakra Petch SemiBold</FontFamily>

    <FontFamily x:Key="FontBody">./Fonts/#IBM Plex Sans</FontFamily>

    <FontFamily x:Key="FontMono">./Fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="FontMonoMedium">./Fonts/#IBM Plex Mono Medium</FontFamily>
    <FontFamily x:Key="FontMonoSemiBold">./Fonts/#IBM Plex Mono SemiBold</FontFamily>

</ResourceDictionary>
